# Copy to infra/.env (scripts/windows/Setup-Fauxel.ps1 does this and fills every CHANGE_ME with a generated secret).
# Never commit infra/.env.

# ---- Domain (Cloudflare) -------------------------------------------------------------------------------
# Your Cloudflare zone. Portal = fauxel.$FAUXEL_DOMAIN, tunnel origin = fauxel-origin.$FAUXEL_DOMAIN
FAUXEL_DOMAIN=ackerworks.com

# ---- Postgres ------------------------------------------------------------------------------------------
POSTGRES_USER=fauxel
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fauxel

# ---- Object storage: local S3 (RustFS container) now, R2 in production -----------------------------------------------------
LOCAL_S3_ACCESS_KEY=fauxel
LOCAL_S3_SECRET_KEY=CHANGE_ME
FAUXEL_STORAGE=s3
# API -> storage (inside the compose network)
FAUXEL_S3_ENDPOINT=http://s3:9000
# Storage as seen by browsers/phones/the host: what goes into presigned multipart PUT URLs
FAUXEL_S3_PUBLIC_ENDPOINT=http://localhost:9000
# path | virtual (R2 supports both; RustFS/MinIO: path)
FAUXEL_S3_ADDRESSING=path
FAUXEL_S3_BUCKET=fauxel-media
S3_IMAGE=rustfs/rustfs:1.0.6
FAUXEL_S3_REGION=us-east-1
# Empty = use LOCAL_S3_ACCESS_KEY / LOCAL_S3_SECRET_KEY.
# Production (R2): FAUXEL_S3_ENDPOINT = FAUXEL_S3_PUBLIC_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
#   FAUXEL_S3_REGION=auto, and the R2 API token pair here. See docs/setup/cloudflare.md.
FAUXEL_S3_ACCESS_KEY=
FAUXEL_S3_SECRET_KEY=
# Largest direct capture upload accepted (MB)
FAUXEL_MAX_DIRECT_UPLOAD_MB=20480

# ---- API -----------------------------------------------------------------------------------------------
# on = X-Fauxel-Key required (plugins/scripts) ; off = local dev only
FAUXEL_AUTH=on
# 1 only when the API is reachable ONLY through the Worker/Cloudflare Access (it then trusts Cf-Access-Authenticated-User-Email)
FAUXEL_TRUST_ACCESS_HEADER=0
FAUXEL_KEY_SALT=CHANGE_ME
# Header X-Fauxel-Admin for POST /api-keys
FAUXEL_ADMIN_TOKEN=CHANGE_ME
FAUXEL_KAFKA_BOOTSTRAP=redpanda:9092
# Base URL used in evidence links. Local: http://localhost:8080. Production: https://fauxel.<domain>
FAUXEL_PUBLIC_URL=http://localhost:8080
FAUXEL_BLUR_MIN=20
FAUXEL_MAX_FRAMES=1500
FAUXEL_MAX_UPLOAD_MB=2048
# CV inference batch size. 2 suits an 8-12 GB NVIDIA GPU; raise on larger cards
FAUXEL_INFER_BATCH=2
# Host folder with trained ONNX trade models (<trade>/manifest.json + model.onnx), mounted at /models (= FAUXEL_MODEL_DIR). Empty folder = heuristic.
FAUXEL_MODEL_DIR_HOST=./models
# Build args
WITH_SPECKLE=1
# Builds behind a TLS-intercepting proxy only: path to the proxy CA bundle (passed as a build secret)
BUILD_CA_BUNDLE=

# ---- Integrations (optional) ----------------------------------------------------------------------------
# Fernet key: encrypts stored APS/Speckle tokens at rest. CHANGE_ME is replaced by the setup script. Losing it = re-authorize APS.
FAUXEL_TOKEN_KEY=CHANGE_ME
# APS (Autodesk Forma / ACC). Callback must equal the app's registered callback and bypass Cloudflare Access (see access-policy.md)
FAUXEL_APS_CLIENT_ID=
FAUXEL_APS_CLIENT_SECRET=
FAUXEL_APS_CALLBACK_URL=https://fauxel.ackerworks.com/api/v1/integrations/aps/callback
FAUXEL_APS_WEBHOOK_SECRET=CHANGE_ME
FAUXEL_APS_SCOPES_3LO=
FAUXEL_APS_SCOPES_2LO=
FAUXEL_APS_BASE_URL=
FAUXEL_APS_REGION=
# Speckle personal access token (fallback when none is stored through PUT /integrations/speckle/token)
FAUXEL_SPECKLE_TOKEN=

# ---- Host ports (all bound to 127.0.0.1) ----------------------------------------------------------------
DB_PORT=5432
S3_PORT=9000
S3_CONSOLE_PORT=9001
REDPANDA_PORT=19092
API_PORT=8000
PORTAL_PORT=8080

# ---- Cloudflare Tunnel (docker compose --profile tunnel up -d, or the Windows service) --------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Backups to R2 (scripts/backup.sh, Backup-Fauxel.ps1) -------------------------------------------------
# R2 S3 API endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; bucket for dumps (separate from fauxel-media)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=fauxel-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=14
